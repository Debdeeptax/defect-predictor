# Copy to .env and adjust
FLASK_ENV=development
SECRET_KEY=change-me
HOST=127.0.0.1
PORT=5000

DATABASE_URL=sqlite:///instance/sdp.db
UPLOAD_DIR=instance/uploads
WORKSPACE_DIR=instance/workspaces
MODEL_DIR=models
LOG_DIR=logs
LOG_LEVEL=INFO

# Limits
MAX_UPLOAD_MB=20
MAX_FILES_PER_ANALYSIS=2000
GIT_CLONE_TIMEOUT_SEC=60
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org

# Risk thresholds (probability)
RISK_MEDIUM_THRESHOLD=0.4
RISK_HIGH_THRESHOLD=0.7
